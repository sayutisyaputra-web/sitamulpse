    if ($rataDurasi === null) {
        $teksDurasi = '-';
    } elseif ($rataDurasi >= 60) {
        $teksDurasi = intdiv($rataDurasi, 60) . ' j ' . ($rataDurasi % 60) . ' m';
    } else {
        $teksDurasi = $rataDurasi . ' menit';
    }

    // Grafik 14 hari: 80% tinggi area = nilai tertinggi
            $tertinggi = (int) collect($grafikHari)->max('total');
    $maks = max(4, (int) (ceil($tertinggi / 4) * 4));
    $garis = [80 => $maks, 40 => intdiv($maks, 2), 0 => 0];

    // Status bulan ini
    $warnaStatus = [
        'menunggu' => 'bg-amber-400',
        'diterima' => 'bg-sky-500',
        'selesai'  => 'bg-emerald-500',
        'ditolak'  => 'bg-red-500',
    ];
    $jumlahStatus = max(1, (int) collect($perStatus)->sum());
    $jumlahBulan = max(1, (int) $bulanIni);
@endphp

